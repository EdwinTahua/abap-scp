@EndUserText.label: 'SB Travel'
define service Ysd_travel {
  expose y_c_travel              as Travel;
  expose y_c_booking             as Booking;
  expose y_c_book_suppl          as BookingSupplement;
  expose /DMO/I_Supplement_StdVH as Supplement;





  expose I_CurrencyStdVH         as Currency;
  expose I_CountryVH             as Country;
}